/* Dark forest theme overrides */

/* Darker green for nav/footer/banners — deeper than Tachyons bg-dark-green */
.bg-forest-dark {
  background-color: #0a3d26;
}

/* Card background — dark green-tinted, slightly lighter than body */
.bg-forest-card {
  background-color: #102a1e;
}

/* Card title links */
.bg-forest-card h1 a,
.bg-forest-card h2 a,
.bg-forest-card .near-black,
.bg-forest-card .black {
  color: #d4e8dc;
}

.bg-forest-card h1 a:hover,
.bg-forest-card h2 a:hover {
  color: #ffffff;
}

/* Section label above card title */
.bg-forest-card span.f6 {
  color: #7aab8a;
}

/* Read more button */
.bg-forest-card a.ba {
  background-color: #1e4a33;
  border-color: #4a9e6e;
  color: #c8e0d0;
}

.bg-forest-card a.ba:hover {
  background-color: #2d6b4a;
  color: #ffffff;
}

/* Post header: section label, title, date, author */
.post-header-forest aside,
.post-header-forest h1,
.post-header-forest p,
.post-header-forest time,
.post-header-forest span {
  color: #d4e8dc;
}

/* Summary text color */
.bg-forest-card .gray,
.bg-forest-card .mid-gray {
  color: #a8c4b0;
}

/* Cards grid — gap uniforme, centrado */
.cards-grid {
  gap: 1.5rem;
  justify-content: center;
}

/* Poem grid */
.poem-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1rem;
}

@media screen and (min-width: 30em) {
  .poem-grid { grid-template-columns: repeat(2, 1fr); }
}

@media screen and (min-width: 60em) {
  .poem-grid { grid-template-columns: repeat(3, 1fr); }
}

/* Chapter divider — spans full grid width */
.chapter-divider {
  grid-column: 1 / -1;
  display: flex;
  align-items: center;
  gap: 0.75rem;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  margin-top: 2rem;
  padding-bottom: 0.5rem;
}

.chapter-divider::after {
  content: '';
  flex: 1;
  border-top: 1px solid #2d6b4a;
}

/* Poem cards — altura fija uniforme */
.poem-card {
  height: 160px;
  border: 1px solid #1e4a33;
  transition: border-color 0.2s, transform 0.2s;
}

.poem-card:hover {
  border-color: #4a9e6e;
  transform: translateY(-2px);
}

.poem-card-inner {
  background: linear-gradient(180deg,
    rgba(8, 18, 12, 0.82) 0%,
    rgba(8, 18, 12, 0.30) 42%,
    rgba(8, 18, 12, 0.30) 58%,
    rgba(8, 18, 12, 0.88) 100%);
}

.poem-card h2 a {
  text-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);
}

.poem-card .poem-chapter {
  text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
}

.poem-chapter {
  color: #7aab8a;
  letter-spacing: 0.06em;
}

.poem-read-link {
  background-color: #1e4a33;
  border-color: #4a9e6e;
  color: #c8e0d0;
}

.poem-read-link:hover {
  background-color: #2d6b4a;
  color: #ffffff;
}

/* License / copyright block — subtle metadata below post content */
.license-block {
  margin-top: 6rem;
  padding-top: 1.25rem;
  border-top: 1px solid #1e4a33;
}

.license-block p {
  margin: 0;
  font-size: 0.78rem;
  line-height: 1.5;
  color: #5e8a70;
  letter-spacing: 0.02em;
}

/* ===================================================== */
/* Wallpaper de escritorio — aplicado a TODA la web      */
/* ===================================================== */

/* body.bg-near-black gana en especificidad a la clase de Tachyons */
body.bg-near-black {
  background-color: #0c1612;
  background-image:
    radial-gradient(ellipse 720px 220px at 18% 22%, rgba(122,171,138,0.07), transparent 70%),
    radial-gradient(ellipse 900px 260px at 82% 68%, rgba(122,171,138,0.055), transparent 72%),
    radial-gradient(ellipse 560px 180px at 50% 92%, rgba(122,171,138,0.04), transparent 70%),
    repeating-linear-gradient(0deg, rgba(212,232,220,0.018) 0 1px, transparent 1px 4px),
    repeating-linear-gradient(90deg, rgba(0,0,0,0.05) 0 1px, transparent 1px 3px);
  background-attachment: fixed;
}

/* Wallpapers por volumen — se aplican sumando .vol-* al body */
body.vol-niebla {
  background-image:
    radial-gradient(ellipse 720px 220px at 18% 22%, rgba(122,171,138,0.10), transparent 70%),
    radial-gradient(ellipse 900px 260px at 82% 68%, rgba(122,171,138,0.08), transparent 72%),
    repeating-linear-gradient(0deg, rgba(212,232,220,0.022) 0 1px, transparent 1px 4px);
}

body.vol-hojas {
  background-image:
    radial-gradient(circle at 12% 18%, rgba(122,171,138,0.16) 0 2px, transparent 3px),
    radial-gradient(circle at 38% 30%, rgba(74,158,110,0.12) 0 2.5px, transparent 4px),
    radial-gradient(circle at 72% 22%, rgba(122,171,138,0.14) 0 2px, transparent 3px),
    radial-gradient(circle at 88% 55%, rgba(74,158,110,0.10) 0 2px, transparent 3px),
    radial-gradient(circle at 24% 72%, rgba(122,171,138,0.13) 0 1.8px, transparent 3px),
    radial-gradient(circle at 60% 84%, rgba(74,158,110,0.10) 0 2px, transparent 3px);
}

body.vol-lluvia {
  background-image:
    repeating-linear-gradient(105deg, rgba(168,196,176,0.10) 0 1px, transparent 1px 8px),
    repeating-linear-gradient(105deg, rgba(122,171,138,0.06) 0 1px, transparent 1px 14px);
}

body.vol-corteza {
  background-image:
    repeating-linear-gradient(0deg, rgba(74,158,110,0.08) 0 2px, transparent 2px 6px, rgba(122,171,138,0.06) 6px 7px, transparent 7px 13px),
    repeating-linear-gradient(90deg, rgba(0,0,0,0.18) 0 1px, transparent 1px 9px);
}

/* ===================================================== */
/* Chrome de ventana Nautilus / GNOME 2                  */
/* ===================================================== */

.nau-window {
  max-width: 920px;
  margin: 2rem auto;
  background: #dcdad5;
  border: 1px solid #1e4a33;
  border-radius: 4px 4px 2px 2px;
  box-shadow: 0 1px 0 rgba(255, 255, 255, 0.6) inset, 0 8px 24px rgba(0, 0, 0, 0.5);
  font-family: 'Bitstream Vera Sans', 'DejaVu Sans', 'Liberation Sans', 'Verdana', sans-serif;
  color: #2a2a28;
  overflow: hidden;
}

/* --- Barra de título --- */
.nau-titlebar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 6px;
  background: linear-gradient(180deg, #4a9e6e 0%, #2d6b4a 60%, #1e4a33 100%);
  color: #fff;
  text-shadow: 0 1px 0 rgba(0, 0, 0, 0.35);
  font-size: 13px;
  font-weight: bold;
}

.nau-titlebar-icon {
  width: 14px;
  height: 14px;
  flex: 0 0 auto;
  background: linear-gradient(180deg, #d4e8dc, #7aab8a);
  border: 1px solid #0a3d26;
  border-radius: 2px;
}

.nau-titlebar-text {
  flex: 1 1 auto;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.nau-titlebar-buttons {
  display: flex;
  gap: 4px;
  flex: 0 0 auto;
}

.nau-wbtn {
  width: 18px;
  height: 16px;
  line-height: 14px;
  font-size: 11px;
  text-align: center;
  color: #103021;
  background: linear-gradient(180deg, #e8f0ea, #a8c4b0);
  border: 1px solid #1e4a33;
  border-radius: 2px;
  cursor: default;
  padding: 0;
}

.nau-wbtn--close {
  background: linear-gradient(180deg, #e9847a, #b03d2e);
  color: #fff;
  border-color: #7a2418;
}

/* --- Barra de menú --- */
.nau-menubar {
  display: flex;
  gap: 14px;
  padding: 3px 10px;
  background: #dcdad5;
  border-bottom: 1px solid #b7b4ae;
  font-size: 12px;
}

.nau-menu {
  cursor: default;
}

.nau-menu u {
  text-decoration: underline;
}

/* --- Barra de herramientas --- */
.nau-toolbar {
  display: flex;
  align-items: center;
  gap: 4px;
  padding: 5px 8px;
  background: linear-gradient(180deg, #ebe9e4, #cfccc6);
  border-bottom: 1px solid #b7b4ae;
}

.nau-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  padding: 3px 8px;
  font-size: 12px;
  color: #2a2a28;
  background: linear-gradient(180deg, #f5f3ee, #d6d3cd);
  border: 1px solid #8d8a85;
  border-radius: 3px;
  cursor: default;
}

.nau-btn-ico {
  font-size: 13px;
  line-height: 1;
  color: #2d6b4a;
}

.nau-btn--disabled {
  color: #9a9892;
}

.nau-btn--disabled .nau-ico-fwd {
  color: #a8c4b0;
}

.nau-toolbar-sep {
  width: 1px;
  align-self: stretch;
  margin: 2px 4px;
  background: #b7b4ae;
  box-shadow: 1px 0 0 rgba(255, 255, 255, 0.6);
}

.nau-toolbar-spacer {
  flex: 1 1 auto;
}

.nau-viewas {
  font-size: 12px;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.nau-viewas-select {
  font-size: 12px;
  padding: 2px 4px;
  border: 1px solid #8d8a85;
  border-radius: 3px;
  background: #f5f3ee;
}

/* --- Barra de ubicación --- */
.nau-location {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 5px 8px;
  background: #dcdad5;
  border-bottom: 1px solid #b7b4ae;
}

.nau-location-label {
  font-size: 12px;
  flex: 0 0 auto;
}

.nau-location-input {
  flex: 1 1 auto;
  font-family: 'DejaVu Sans Mono', 'Liberation Mono', monospace;
  font-size: 12px;
  padding: 3px 6px;
  color: #2a2a28;
  background: #fbfbf9;
  border: 1px solid #8d8a85;
  border-radius: 3px;
}

/* --- Cuerpo: sidebar + contenido --- */
.nau-body {
  display: flex;
  align-items: stretch;
  min-height: 360px;
}

.nau-sidebar {
  flex: 0 0 200px;
  width: 200px;
  background: #cfccc6;
  border-right: 1px solid #b7b4ae;
  padding: 8px 0;
}

.nau-sidebar-heading {
  font-size: 11px;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #6b6860;
  padding: 4px 12px;
}

.nau-places {
  list-style: none;
  margin: 0;
  padding: 0;
}

.nau-places--nested {
  margin-left: 14px;
}

.nau-place {
  display: block;
  padding: 4px 12px;
  font-size: 12px;
  color: #2a2a28;
  text-decoration: none;
}

.nau-place:hover {
  background: rgba(74, 158, 110, 0.18);
}

.nau-place--active {
  background: linear-gradient(180deg, #4a9e6e, #2d6b4a);
  color: #fff;
  text-shadow: 0 1px 0 rgba(0, 0, 0, 0.3);
}

.nau-place--active:hover {
  background: linear-gradient(180deg, #4a9e6e, #2d6b4a);
}

.nau-content {
  flex: 1 1 auto;
  background: #ffffff;
  padding: 16px;
  overflow: auto;
}

/* --- Barra de estado --- */
.nau-statusbar {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 4px 10px;
  background: #dcdad5;
  border-top: 1px solid #b7b4ae;
  font-size: 11px;
  color: #4a4843;
}

.nau-status-right {
  margin-left: auto;
}

.nau-status-right::before {
  content: "·";
  margin-right: 8px;
  color: #9a9892;
}

.nau-resize {
  width: 12px;
  height: 12px;
  flex: 0 0 auto;
  margin-left: 4px;
  background-image:
    linear-gradient(135deg, transparent 45%, #9a9892 45%, #9a9892 55%, transparent 55%),
    linear-gradient(135deg, transparent 70%, #9a9892 70%, #9a9892 80%, transparent 80%);
}

@media (max-width: 640px) {
  .nau-window {
    margin: 1rem 0.5rem;
  }
  .nau-sidebar {
    display: none;
  }
}
